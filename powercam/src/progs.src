../csaddon.dat

#define CSQC
#pragma target fte

#define debug(fmt, ...) do { if (cvar("pip_debug")) { print(sprintf(sprintf("&c47fdebug:&r %s\n", fmt), ##__VA_ARGS__)); } } while (0)
#define println(fmt,...) do { print(sprintf(sprintf("%s\n", fmt), ##__VA_ARGS__)); } while (0)

// Drawmask bits used across the addon (also referenced from minimap.qc).
#define MASK_XRAY  (1<<3)
#define MASK_LOCAL (1<<4)

// Dump with /pr_dumpplatform -o csplat -Tcs
csplat.qc

itemtype.qc
cameras.qc
itemtimer.qc
minimap.qc
score_overlay.qc
main.qc
