../csaddon.dat

#define CSQC
#pragma target fte

#define debug(fmt, ...) do { if (cvar("pip_debug")) { print(sprintf(sprintf("&c47fdebug:&r %s\n", fmt), ##__VA_ARGS__)); } } while (0)
#define println(fmt,...) do { print(sprintf(sprintf("%s\n", fmt), ##__VA_ARGS__)); } while (0)

// Drawmask bits used across the addon (also referenced from minimap.qc).
#define MASK_XRAY  (1<<3)
#define MASK_LOCAL (1<<4)

// FTE deltalisten() flags - which interpolation phases to skip.
#define RSES_NOLERP   1
#define RSES_NOROTATE 2
#define RSES_NOTRAILS 4
#define RSES_NOLIGHTS 8

// Dump with /pr_dumpplatform -o csplat -Tcs
csplat.qc

// Math helpers
easing.qc

// Data + types
itemtype.qc
cameras.qc

// Item spawn / pickup tracker (used by PiP scheduler and minimap)
itemtimer.qc

// Independent rendering features
xray.qc
minimap.qc
score_overlay.qc

// PiP powerup-cam: schedule then render
pip_camera.qc
pip_render.qc

// Console commands (depend on all feature state above)
commands.qc

// CSQC lifecycle hooks (Init / WorldLoaded / ServerInfoChanged / UpdateView)
main.qc
