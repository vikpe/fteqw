../csaddon.dat

#define CSQC
#pragma target fte

#define debug(fmt, ...) do { if (cvar("debug")) { print(sprintf(sprintf("&c47fdebug:&r %s\n", fmt), ##__VA_ARGS__)); } } while (0)
#define println(fmt,...) do { print(sprintf(sprintf("%s\n", fmt), ##__VA_ARGS__)); } while (0)

// Drawmask bits used across the addon (also referenced from minimap.qc).
#define MASK_XRAY  (1<<3)
#define MASK_LOCAL (1<<4)

// FTE deltalisten() flags - which interpolation phases to skip.
#define RSES_NOLERP   1

// Dump with /pr_dumpplatform -o csplat -Tcs
csplat.qc

// Math helpers
easing.qc

// 2D drawing primitives (shared by overlays)
draw_util.qc

// Data + types
item_type.qc
participants.qc
powcam_config.qc

// Item spawn / pickup tracker (used by powcam scheduler and minimap)
item_timer.qc

// Independent rendering features
xray.qc

// Minimap: shared data and primitives first, then load, players, render, commands.
minimap_data.qc

// Minimap cull-volume editor - needs minimap_volumes from minimap_data,
// and is called from main.qc render flow below.
minimap_editor.qc

minimap_load.qc
minimap_players.qc
minimap.qc
minimap_teleport.qc
minimap_commands.qc

overlay.qc
player_info.qc

// Mode-driven side effects (cvar toggles etc.)
misc.qc

// Powerup-cam: schedule then render
powcam.qc
powcam_render.qc
powcam_commands.qc

// Console commands (depend on all feature state above)
commands.qc

// CSQC lifecycle hooks (Init / WorldLoaded / ServerInfoChanged / UpdateView)
main.qc
